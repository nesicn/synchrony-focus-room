# ==========================================
# Comprehensive .gitignore for SYNCHRONY & Modern Web Projects
# ==========================================

# ------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------
node_modules/
jspm_packages/
web_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ------------------------------------------
# 2. Production Builds & Outputs
# ------------------------------------------
dist/
dist-ssr/
build/
out/
.output/
*.tsbuildinfo
server.js
dist/server.cjs

# ------------------------------------------
# 3. Environment Variables & Secrets (CRITICAL)
# ------------------------------------------
# Ignore all .env files and local configuration overrides
.env
.env.*
*.env
*.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.template
!.env.sample

# API Keys, Private Certificates, and Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa*
id_ed25519*
secrets/
credentials.json
*-credentials.json
serviceAccountKey*.json
client_secret*.json
google-services.json
GoogleService-Info.plist

# ------------------------------------------
# 4. Logs, Diagnostics & Debug
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
firebase-debug.log*
firestore-debug.log*

# ------------------------------------------
# 5. Testing & Code Coverage
# ------------------------------------------
coverage/
*.lcov
.nyc_output/
cypress/videos/
cypress/screenshots/
.playwright/
test-results/

# ------------------------------------------
# 6. IDEs & Code Editors
# ------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------
# 8. Caches & Temporary Files
# ------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.prettiercache
tmp/
temp/
.temp/
.vite/
assets/.aistudio/
